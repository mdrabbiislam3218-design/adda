rules_version = '2';

// Firebase Console -> Firestore Database -> Rules ট্যাবে এই পুরো লেখা পেস্ট করে Publish করুন।
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ব্যবহারকারীর প্রোফাইল: লগইন করা সবাই দেখতে পারবে, শুধু নিজেরটা বদলাতে পারবে
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // পোস্ট
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;

      // মালিক সবকিছু বদলাতে পারবে; অন্যরা শুধু লাইক ও মন্তব্যের সংখ্যা বদলাতে পারবে
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // মেসেঞ্জার: chatId = দুজনের uid সাজিয়ে "_" দিয়ে জোড়া, তাই শুধু ওই দুজনই দেখতে পারবে
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in chatId.split('_')
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn()
          && request.auth.uid in chatId.split('_')
          && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
